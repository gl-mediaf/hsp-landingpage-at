---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum – hsp Die Fundraiser GmbH"
  description="Impressum der hsp Die Fundraiser GmbH"
>
<style>
  .legal-page { max-width: 760px; margin: 0 auto; padding: 6rem 1.5rem 4rem; font-family: 'Inter', Arial, sans-serif; color: #333; }
  .legal-page nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: #1B2A4A; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
  .legal-page nav a { color: #97BF0D; font-size: 0.875rem; font-weight: 600; text-decoration: none; }
  .legal-page nav a:hover { text-decoration: underline; }
  .legal-page nav img { height: 36px; }
  .legal-page h1 { font-size: 2rem; font-weight: 800; color: #1B2A4A; margin-bottom: 2rem; }
  .legal-page h2 { font-size: 1.1rem; font-weight: 700; color: #1B2A4A; margin: 2rem 0 0.5rem; }
  .legal-page p { line-height: 1.75; margin-bottom: 1rem; font-size: 0.95rem; }
  .legal-page .info-block { background: #f8f9fa; border-left: 3px solid #97BF0D; padding: 1.25rem 1.5rem; border-radius: 0 8px 8px 0; margin-bottom: 2rem; }
  .legal-page .info-block p { margin: 0; line-height: 1.8; }
  .legal-page footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; display: flex; gap: 1.5rem; font-size: 0.8rem; color: #999; }
  .legal-page footer a { color: #999; text-decoration: none; }
  .legal-page footer a:hover { color: #1B2A4A; }
</style>

<div class="legal-page">
  <nav>
    <a href="/">← Zurück</a>
    <img src="/images/hsp-logo.png" alt="hsp" onerror="this.style.display='none'" />
  </nav>

  <h1>Impressum</h1>

  <div class="info-block">
    <p>
      <strong>hsp Die Fundraiser GmbH</strong><br />
      Zielstattstraße 11, D-81379 München<br />
      Telefon: +49 (0) 89 45 22 34 20<br />
      E-Mail: office [at] hsp.at
    </p>
  </div>

  <p><strong>Vertretungsberechtigte Person:</strong> Georg Kolb</p>
